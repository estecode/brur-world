# Cells are internal streaming units, never visible world boundaries. Viewport
# coverage adapts cell scale when necessary to remain inside the explicit
# resident bound; near-first publication lets gameplay resume while the rest
# of the visible population streams. Far geometry keeps city massing cheap.
cell_size_m = 3000.0
max_buildings_per_cell = 3000
max_roads_per_cell = 2500
far_lod_altitude_m = 3500.0
refresh_interval_s = 0.1
