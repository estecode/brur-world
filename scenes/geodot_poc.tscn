# Keep the bounded 7x7 resident set while extending prepared coverage from
# 14 km to 21 km. Cells remain an internal streaming unit, never a visible
# world boundary. Keep the distant representation deliberately cheap: the
# city silhouette must survive, but far detail must not consume near-detail
# geometry budgets at high altitude.
cell_size_m = 3000.0
max_buildings_per_cell = 3000
max_roads_per_cell = 2500
far_lod_altitude_m = 3500.0
refresh_interval_s = 0.1
